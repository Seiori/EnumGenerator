<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Generated code must compile warning-free in a strict consumer project. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- xUnit1051: Roslyn's CancellationToken-accepting APIs don't need test-cancellation plumbing here. -->
        <NoWarn>$(NoWarn);CS1591;xUnit1051</NoWarn>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="xunit.v3" Version="4.0.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.15" />
        <PackageReference Include="Basic.Reference.Assemblies.NetStandard20" Version="1.8.15" />
    </ItemGroup>

    <ItemGroup>
        <!-- Runs the generator on this project's own enums (runtime tests) and exposes it for in-memory driver tests. -->
        <ProjectReference Include="..\EnumGenerator\EnumGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    </ItemGroup>

</Project>
